{
  "name": "tap-rope",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "ios": "npm run build:office-app && cap sync ios",
    "android": "npm run build:office-app && cap sync android",
    "build:sim": "vite build --config vite.sim.config.ts",
    "build:office": "tsc --noEmit && vite build --config vite.office.config.ts --mode office",
    "build:office-app": "tsc --noEmit && vite build --config vite.office.config.ts --mode office-app"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.4.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capgo/native-purchases": "^8.9.16",
    "@supabase/auth-js": "2.117.3"
  }
}
